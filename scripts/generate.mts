/**
 * Regenerate the node from the RoxyAPI OpenAPI spec.
 *
 * Run:    npm run generate            (fetches the live spec; the release workflow)
 *         ROXYAPI_SPEC_FILE=specs/openapi.json npm run generate   (hermetic; CI and hooks)
 * Does:   rewrites specs/openapi.json from its input, emits one resource file per spec tag,
 *         and syncs the generated regions of README.md.
 * Writes: specs/openapi.json, nodes/RoxyApi/spec.gen.ts, nodes/RoxyApi/resources/*.gen.ts,
 *         README.md (between the BEGIN and END markers only).
 * Pairs:  scripts/model.mts owns every decision about how a spec field maps to n8n; this file
 *         only serializes it. tests/node.test.mts asserts the built output against the same model.
 */
import { readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import {
	type Field,
	type NodeModel,
	type NodeOperation,
	type NodeResource,
	buildModel,
	operationCount,
	titleCase,
	type Spec,
} from './model.mts';

const LIVE_SPEC = 'https://roxyapi.com/api/v2/openapi.json';
const SPEC_PATH = 'specs/openapi.json';
const RESOURCES_DIR = 'nodes/RoxyApi/resources';
const HEADER = '// Generated by scripts/generate.mts from specs/openapi.json. Do not edit.\n';

const JSON_VALUE = '={{ typeof $value === "string" ? JSON.parse($value) : $value }}';
const TIMEZONE_VALUE = '={{ $value !== "" && !isNaN(Number($value)) ? Number($value) : $value }}';

async function loadSpec(): Promise<Spec> {
	const file = process.env.ROXYAPI_SPEC_FILE;
	if (file) return JSON.parse(readFileSync(file, 'utf8'));
	const res = await fetch(LIVE_SPEC);
	if (!res.ok) throw new Error(`generate: ${LIVE_SPEC} returned ${res.status}`);
	return res.json();
}

/**
 * A TypeScript object literal with bare identifier keys. Not JSON: the n8n lint rules and their
 * fixers match only identifier keys, so a quoted `"description":` would slip past both.
 */
function literal(value: unknown, depth = 0): string {
	const pad = '\t'.repeat(depth + 1);
	const end = '\t'.repeat(depth);
	if (typeof value === 'string')
		return `'${value.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, '\\n')}'`;
	if (typeof value === 'number' || typeof value === 'boolean') return String(value);
	if (Array.isArray(value)) {
		if (value.length === 0) return '[]';
		if (value.every((v) => typeof v !== 'object'))
			return `[${value.map((v) => literal(v)).join(', ')}]`;
		return `[\n${value.map((v) => `${pad}${literal(v, depth + 1)},`).join('\n')}\n${end}]`;
	}
	if (value && typeof value === 'object') {
		const entries = Object.entries(value).filter(([, v]) => v !== undefined);
		if (entries.length === 0) return '{}';
		const key = (k: string) => (/^[A-Za-z_$][\w$]*$/.test(k) ? k : literal(k));
		return `{\n${entries.map(([k, v]) => `${pad}${key(k)}: ${literal(v, depth + 1)},`).join('\n')}\n${end}}`;
	}
	throw new Error(`generate: cannot serialize ${String(value)}`);
}

function byName<T extends { name: string }>(items: T[]): T[] {
	return [...items].sort((a, b) => a.name.localeCompare(b.name, 'en'));
}

const LANGUAGES = new Intl.DisplayNames(['en'], { type: 'language' });

/**
 * The option label for one enum value. `lang` is the one i18n parameter every route shares,
 * and its BCP 47 codes read as language names; any other lower-case value is title-cased,
 * and codes such as `S2` stay exactly as sent.
 */
function optionName(field: string, value: string): string {
	if (field === 'lang') return LANGUAGES.of(value) ?? value;
	return /^[a-z]/.test(value) ? titleCase(value) : value;
}

function options(field: string, values: string[]) {
	const list = byName(values.map((value) => ({ name: optionName(field, value), value })));
	if (new Set(list.map((o) => o.name)).size !== list.length)
		throw new Error(`generate: option names collide in ${field}`);
	return list;
}

function scalarExample(f: Field): string | undefined {
	return typeof f.example === 'string' || typeof f.example === 'number'
		? String(f.example)
		: undefined;
}

/** One n8n parameter for one spec field, without its displayOptions. */
function parameter(f: Field): Record<string, unknown> {
	const base: Record<string, unknown> = { displayName: f.displayName, name: f.param };
	const send =
		f.location === 'path'
			? undefined
			: {
					send: {
						type: f.location,
						property: f.name,
						value:
							f.kind === 'json' ? JSON_VALUE : f.kind === 'timezone' ? TIMEZONE_VALUE : undefined,
					},
				};
	const example = scalarExample(f);
	switch (f.kind) {
		case 'options': {
			const list = options(f.name, f.values ?? []);
			const fallback = list.find((o) => o.value === f.initial)?.value ?? list[0].value;
			Object.assign(base, { type: 'options', options: list, default: fallback });
			break;
		}
		case 'multiOptions': {
			const values = f.values ?? [];
			const chosen = Array.isArray(f.initial)
				? f.initial.map(String).filter((v) => values.includes(v))
				: [];
			Object.assign(base, {
				type: 'multiOptions',
				options: options(f.name, values),
				default: chosen,
			});
			break;
		}
		case 'number': {
			const typeOptions = {
				minValue: f.minimum,
				maxValue: f.maximum,
				numberPrecision: f.integer ? undefined : 6,
			};
			Object.assign(base, {
				type: 'number',
				default: typeof f.initial === 'number' ? f.initial : 0,
				typeOptions: Object.values(typeOptions).some((v) => v !== undefined)
					? typeOptions
					: undefined,
			});
			break;
		}
		case 'boolean':
			Object.assign(base, { type: 'boolean', default: f.initial === true });
			break;
		case 'json':
			Object.assign(base, { type: 'json', default: JSON.stringify(f.initial ?? {}, null, 2) });
			break;
		case 'timezone': {
			// One IANA name and one decimal offset, the spec example standing in for whichever it is.
			const numeric = example !== undefined && !Number.isNaN(Number(example));
			Object.assign(base, {
				type: 'string',
				default: '',
				placeholder: numeric
					? `e.g. America/New_York or ${example}`
					: `e.g. ${example ?? 'America/New_York'} or -5`,
			});
			break;
		}
		default:
			Object.assign(base, {
				type: 'string',
				default: '',
				placeholder: example === undefined ? undefined : `e.g. ${example}`,
			});
	}
	if (f.required) base.required = true;
	if (f.description) base.description = f.description;
	if (send) base.routing = send;
	return base;
}

function url(op: NodeOperation): string {
	if (!op.path.includes('{')) return op.path;
	return `=${op.path.replace(/\{(\w+)\}/g, (_, name: string) => `{{encodeURIComponent($parameter["${name}"])}}`)}`;
}

function resourceFile(resource: NodeResource): string {
	const operations = byName(resource.operations);
	const properties: unknown[] = [
		{
			displayName: 'Operation',
			name: 'operation',
			type: 'options',
			noDataExpression: true,
			displayOptions: { show: { resource: [resource.value] } },
			options: operations.map((op) => ({
				name: op.name,
				value: op.value,
				action: op.action,
				description: op.description,
				routing: { request: { method: op.method, url: url(op) } },
			})),
			default: operations[0].value,
		},
	];
	for (const op of operations) {
		const show = { show: { resource: [resource.value], operation: [op.value] } };
		for (const f of op.fields.filter((x) => x.required))
			properties.push({ ...parameter(f), displayOptions: show });
		const optional = op.fields.filter((x) => !x.required);
		if (optional.length > 0) {
			properties.push({
				displayName: 'Options',
				name: 'options',
				type: 'collection',
				placeholder: 'Add Option',
				default: {},
				displayOptions: show,
				options: optional
					.map(parameter)
					.sort((a, b) => String(a.displayName).localeCompare(String(b.displayName), 'en')),
			});
		}
	}
	return `${HEADER}import type { INodeProperties } from 'n8n-workflow';\n\nexport const ${resource.value}Description: INodeProperties[] = ${literal(properties)};\n`;
}

function indexFile(model: NodeModel): string {
	const imports = model.resources
		.map((r) => `import { ${r.value}Description } from './${r.value}.gen';`)
		.join('\n');
	const selector = {
		displayName: 'Resource',
		name: 'resource',
		type: 'options',
		noDataExpression: true,
		options: byName(
			model.resources.map((r) => ({
				name: r.name,
				value: r.value,
				description: r.description || undefined,
			})),
		),
		default: model.resources[0].value,
	};
	return `${HEADER}import type { INodeProperties } from 'n8n-workflow';\n${imports}\n\nexport const resourceProperties: INodeProperties[] = [\n\t${literal(selector, 1)},\n${model.resources.map((r) => `\t...${r.value}Description,`).join('\n')}\n];\n`;
}

function replaceRegion(text: string, name: string, body: string): string {
	const begin = `<!-- BEGIN:${name} -->`;
	const end = `<!-- END:${name} -->`;
	const from = text.indexOf(begin);
	const to = text.indexOf(end);
	if (from < 0 || to < from) throw new Error(`generate: README.md is missing the ${name} markers`);
	return `${text.slice(0, from + begin.length)}\n${body}\n${text.slice(to)}`;
}

function syncReadme(model: NodeModel): void {
	const total = operationCount(model);
	const summary = [
		`${total} operations across ${model.resources.length} resources, one per RoxyAPI domain, in the order the API lists them.`,
		'',
		'| Resource | Operations |',
		'|---|---|',
		...model.resources.map((r) => `| ${r.name} | ${r.operations.length} |`),
	].join('\n');
	const reference = model.resources
		.map((r) =>
			[
				`### ${r.name}`,
				'',
				r.description,
				'',
				...r.operations.map((o) => `- **${o.name}**: ${o.description}`),
			].join('\n'),
		)
		.join('\n\n');
	const codes = [
		...new Set(
			model.resources.flatMap((r) =>
				r.operations.flatMap((o) =>
					o.fields.filter((f) => f.name === 'lang').flatMap((f) => f.values ?? []),
				),
			),
		),
	];
	const languages = codes.map((code) => `${optionName('lang', code)} (\`${code}\`)`).join(', ');
	let readme = readFileSync('README.md', 'utf8');
	readme = replaceRegion(readme, 'RESOURCES', summary);
	readme = replaceRegion(readme, 'LANGUAGES', `${languages}.`);
	readme = replaceRegion(readme, 'OPERATIONS', reference);
	writeFileSync('README.md', readme);
}

const spec = await loadSpec();
const model = buildModel(spec);
writeFileSync(SPEC_PATH, `${JSON.stringify(spec, null, 2)}\n`);
for (const file of readdirSync(RESOURCES_DIR))
	if (file.endsWith('.gen.ts')) rmSync(`${RESOURCES_DIR}/${file}`);
for (const resource of model.resources)
	writeFileSync(`${RESOURCES_DIR}/${resource.value}.gen.ts`, resourceFile(resource));
writeFileSync(`${RESOURCES_DIR}/index.gen.ts`, indexFile(model));
writeFileSync(
	'nodes/RoxyApi/spec.gen.ts',
	`${HEADER}export const BASE_URL = ${literal(model.baseUrl)};\n`,
);
syncReadme(model);
console.log(
	`generate: ${operationCount(model)} operations across ${model.resources.length} resources`,
);
